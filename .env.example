# 复制本文件为 .env 并填入你的 DeepSeek API Key
# 获取地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# —— 联网核验（强烈建议配置，保证时效性信息可稳定核验）——
# 推荐 SerpAPI（https://serpapi.com，免费额度约 100 次/月），engine 用 baidu 对中文更友好
# 不配置也能用：后端会尽力调用百度/搜狗免费搜索，但在云服务器 IP 上可能被反爬限制
SEARCH_API_KEY=
SEARCH_ENGINE=baidu

# 可选配置（不填则用默认值）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# WEB_SEARCH_ENABLED=1
# TOP_K=5
# PORT=8000
